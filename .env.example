# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Optional browser key for Google Maps & Places Autocomplete.
# For prototyping, you can leave empty or use a restricted browser key.
# Restrict key to HTTP referrers and designated APIs (Maps JavaScript API, Places API).
VITE_GOOGLE_MAPS_API_KEY=""

# NOTION KNOWLEDGE BRIDGE INTEGRATION (OAuth 2.0 Backend Configuration)
# NOTION_CLIENT_ID: Public OAuth Client ID from Notion developer portal.
NOTION_CLIENT_ID=""

# NOTION_CLIENT_SECRET: OAuth Client Secret from Notion developer portal.
# Backend-only; never exposed to browser or prefixed with VITE_.
NOTION_CLIENT_SECRET=""

# NOTION_REDIRECT_URI: Configured Notion OAuth Redirect URI.
NOTION_REDIRECT_URI="https://mindledger.ai.studio/api/integrations/notion/callback"

# NOTION_ENCRYPTION_KEY: Optional secret key used for AES-256-GCM token encryption at rest.
NOTION_ENCRYPTION_KEY=""

# GMAIL INTELLIGENCE BRIDGE INTEGRATION (OAuth 2.0 Backend Configuration)
# GMAIL_CLIENT_ID: Dedicated Google OAuth 2.0 Web Client ID for Gmail integration.
GMAIL_CLIENT_ID=""

# GMAIL_CLIENT_SECRET: Google OAuth Client Secret (Backend-only; never exposed to browser).
GMAIL_CLIENT_SECRET=""

# GMAIL_REDIRECT_URI: Authorized redirect URI configured in Google Cloud Console.
GMAIL_REDIRECT_URI="https://mindledger.ai.studio/api/integrations/gmail/callback"

